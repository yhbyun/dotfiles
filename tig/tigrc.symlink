set diff-options = -m --first-parent
set status-show-untracked-files = yes
set split-view-width = 50%

#bind main <Ctrl-f> scroll-page-down
bind generic <Ctrl-F> scroll-page-down
bind generic <Ctrl-B> scroll-page-up

# 260819 yhbyun added
bind main   e !nvim +%(line) %(file)
bind diff   e !nvim +%(line) %(file)
bind status e !nvim %(file)
bind tree   e !nvim %(file)
bind blob   e !nvim +%(line) %(file)


